{
  "name": "deaddrop",
  "version": "1.0.0",
  "description": "A tiny local MCP server that lets AI coding agents on one machine leave each other Markdown messages.",
  "main": "index.js",
  "scripts": {
    "test": "node test/test-server.js",
    "setup-sidecar": "node scripts/setup-sidecar.js",
    "settings": "node index.js settings",
    "app": "electron electron/main.js",
    "build:app": "electron-builder --mac --dir",
    "build:dmg": "electron-builder --mac dmg"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agents"
  ],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "type": "module",
  "bin": {
    "deaddrop": "./index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.forgeaura.deaddrop.settings",
    "productName": "Dead Drop Settings",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dir",
        "dmg"
      ],
      "identity": null,
      "icon": "assets/icon.png"
    },
    "files": [
      "electron/**/*",
      "lib/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    }
  }
}
